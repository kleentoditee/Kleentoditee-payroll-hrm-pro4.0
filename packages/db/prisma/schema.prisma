  orgId      String

  @@index([employeeId, createdAt])
  @@index([orgId])
}

/// Bank deposits (Phase 3 Task 10C).
/// Groups one or more undeposited customer payments into a single
/// bank transaction. When posted, each linked payment's
/// `depositedAt` is set so it can't be modified or re-deposited.
model Deposit {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  number        String
  depositDate   DateTime
  memo          String            @default("")
  bankAccountId String
  bankAccount   Account           @relation("DepositBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  total         Float             @default(0)
  status        TransactionStatus @default(draft)
  postedAt      DateTime?
  voidedAt      DateTime?
  lines         DepositLine[]
  /// Owning organization (Batch 12).
  orgId         String

  @@unique([orgId, number])
  @@index([depositDate])
  @@index([bankAccountId])
  @@index([status])
  @@index([orgId])
}

model DepositLine {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  depositId   String
  deposit     Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  position    Int
  paymentId   String?
  payment     Payment? @relation("DepositLinePayment", fields: [paymentId], references: [id], onDelete: Restrict)
  /// Offset credit account for ad-hoc (non-payment) lines (Batch 13).
  accountId   String?
  account     Account? @relation("DepositLineAccount", fields: [accountId], references: [id], onDelete: Restrict)
  description String   @default("")
  amount      Float
  /// Owning organization (Batch 12).
  orgId       String

  @@index([depositId, position])
  @@index([paymentId])
  @@index([orgId])
}

// --- General ledger (Batch 8, R7) ---
// Double-entry journal core. Every posted business document writes exactly one
// balanced journal identified by a unique sourceKey (idempotent re-posts).
// Corrections never edit posted rows: a reversal journal (sourceType suffixed
// `_reversal`, reversalOfId pointing at the original) undoes the original.

enum JournalEntryStatus {
  /// Manual journals start as drafts, optionally approved, then posted (Batch 13).
  draft
  approved
  posted
  void
}

enum FiscalPeriodStatus {
  open
  /// Soft-close: no new postings, existing docs can still be corrected by reopening.
  soft_closed
  /// Locked: immutable; reopen requires platform_owner (audited).
  locked
}

/// A tenant's fiscal year (calendar-year for KleenToDiTee; dates allow otherwise).
model FiscalYear {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  year      Int
  startDate DateTime
  endDate   DateTime
  closedAt  DateTime?
  /// Owning organization (Batch 12).
  orgId     String

  periods FiscalPeriod[]

  @@unique([orgId, year])
  @@index([orgId])
}

/// One posting month within a fiscal year. Auto-created open on first use;
/// posting is rejected when the period is soft_closed or locked (Batch 13).
model FiscalPeriod {
  id             String             @id @default(cuid())
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  year           Int
  /// 1-12 within the fiscal year.
  period         Int
  startDate      DateTime
  endDate        DateTime
  status         FiscalPeriodStatus @default(open)
  closedAt       DateTime?
  closedByUserId String?
  fiscalYear     FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  fiscalYearId   String
  /// Owning organization (Batch 12).
  orgId          String

  @@unique([orgId, year, period])
  @@index([orgId])
  @@index([startDate, endDate])
}

model JournalEntry {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  date            DateTime
  memo            String             @default("")
  /// invoice | payment | bill | bill_payment | expense | payroll_run (+ `_reversal` variants)
  sourceType      String
  sourceId        String
  /// Unique idempotency key: `${sourceType}:${sourceId}`.
  sourceKey       String
  status          JournalEntryStatus @default(posted)
  reversalOfId    String?
  reversalOf      JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       JournalEntry[]     @relation("JournalReversal")
  createdByUserId String?
  lines           JournalLine[]
  /// Owning organization (Batch 12).
  orgId           String

  @@unique([orgId, sourceKey])
  @@index([date])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([orgId])
}

model JournalLine {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position  Int
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Decimal money: exactly one of debit/credit is > 0 per line.
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
  memo      String       @default("")
  /// Owning organization (Batch 12).
  orgId     String

  @@index([entryId, position])
  @@index([accountId])
  @@index([orgId])
}

// --- Banking and reconciliation (Batch 14) ---
// Statement imports are append-only with per-line fingerprints so a repeated
// import can never duplicate entries. Matching links a statement line to the
// document that moved the bank account (payment, deposit, expense,
// bill_payment, or a manual journal). A reconciliation session clears
// statement lines against an opening balance; completion locks when the
// difference is zero, and a completed reconciliation can only be reopened by
// a controlled, audited unlock of the latest session for that account.

enum BankStatementLineStatus {
  unmatched
  /// Linked to a bank document (payment/deposit/expense/bill_payment/journal).
  matched
  /// Deliberately ignored (e.g. already recorded another way); audit-visible.
  excluded
}

enum BankReconciliationStatus {
  in_progress
  completed
}

/// One imported bank statement file (CSV). Header balances are optional and
/// informational; the lines carry the truth.
model BankStatementImport {
  id                 String    @id @default(cuid())
  createdAt          DateTime  @default(now())
  bankAccount        Account   @relation("BankStatementImportAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankAccountId      String
  fileName           String    @default("")
  /// Statement window, when known from the file.
  statementStartDate DateTime?
  statementEndDate   DateTime?
  openingBalance     Float?
  closingBalance     Float?
  rowCount           Int       @default(0)
  duplicateCount     Int       @default(0)
  importedByUserId   String?
  /// Owning organization (Batch 12).
  orgId              String

  lines BankStatementLine[]

  @@index([bankAccountId])
  @@index([orgId])
}

/// One transaction row from a bank statement. `amount` is signed:
/// positive = money in, negative = money out.
model BankStatementLine {
  id                String                  @id @default(cuid())
  createdAt         DateTime                @default(now())
  importId          String
  import            BankStatementImport     @relation(fields: [importId], references: [id], onDelete: Cascade)
  position          Int
  date              DateTime
  description       String                  @default("")
  reference         String                  @default("")
  amount            Float
  /// sha256 over bankAccountId|date|amount|description|reference — the
  /// duplicate detector. Unique per org, so re-imports skip, never double-post.
  fingerprint       String
  status            BankStatementLineStatus @default(unmatched)
  /// payment | deposit | expense | bill_payment | journal
  matchedEntityType String?
  matchedEntityId   String?
  matchedAt         DateTime?
  matchedByUserId   String?
  /// Set when this line was cleared in a completed reconciliation.
  reconciledAt      DateTime?
  /// Owning organization (Batch 12).
  orgId             String

  reconciliationLines BankReconciliationLine[]

  @@unique([orgId, fingerprint])
  @@index([importId, position])
  @@index([status])
  @@index([date])
  @@index([orgId])
}

/// A reconciliation session for one bank account: opening balance + cleared
/// statement lines must agree with the statement's ending balance to complete.
model BankReconciliation {
  id                     String                   @id @default(cuid())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  bankAccount            Account                  @relation("BankReconciliationAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  bankAccountId          String
  statementEndingDate    DateTime
  statementEndingBalance Float
  /// Ending balance of the previous completed reconciliation (0 for the first).
  openingBalance         Float                    @default(0)
  /// Sum of cleared statement lines (signed). Recomputed on every clear/unclear.
  clearedNet             Float                    @default(0)
  /// statementEndingBalance - (openingBalance + clearedNet); must be ~0 to complete.
  difference             Float                    @default(0)
  status                 BankReconciliationStatus @default(in_progress)
  completedAt            DateTime?
  completedByUserId      String?
  /// Controlled undo: only the latest completed session can be unlocked, with a reason.
  unlockedAt             DateTime?
  unlockedByUserId       String?
  unlockReason           String?
  createdByUserId        String?
  /// Owning organization (Batch 12).
  orgId                  String

  lines BankReconciliationLine[]

  @@index([bankAccountId, status])
  @@index([orgId])
}

/// A statement line cleared inside a reconciliation session. Snapshots the
/// line's date/description/amount so a completed reconciliation is
/// reproducible even if the import row is later inspected or re-matched.
model BankReconciliationLine {
  id               String             @id @default(cuid())
  createdAt        DateTime           @default(now())
  reconciliationId String
  reconciliation   BankReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  statementLineId  String
  statementLine    BankStatementLine  @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  date             DateTime
  description      String             @default("")
  amount           Float
  /// Owning organization (Batch 12).
  orgId            String

  @@unique([reconciliationId, statementLineId])
  @@index([orgId])
}

/// Versioned BVI statutory rate record. One row per effective tax year.
/// Payroll calculations keep reading OrgSettings; this table is the
/// audit/verification source of truth that those live values must match.
/// A version counts as verified only when sourceUrl is set and verifiedAt
/// is filled, and as approved for live use only when approvedAt is filled.
model StatutoryRateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Owning organization (Batch 12).
  orgId     String

  /// Tax year the rates apply to (e.g. 2026).
  effectiveYear Int
  /// Optional in-year effective range for mid-year rate changes.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// BVI Social Security Board contribution.
  ssbEmployeeRate  Float
  ssbEmployerRate  Float
  ssbAnnualCeiling Float
  ssbEnabled       Boolean @default(true)

  /// BVI National Health Insurance contribution.
  nhiEmployeeRate  Float
  nhiEmployerRate  Float
  nhiAnnualCeiling Float
  nhiEnabled       Boolean @default(true)

  /// BVI payroll tax (employee withholding + employer Class 1/2 share).
  payrollTaxEmployeeRate    Float
  payrollTaxEmployerClass   PayrollTaxClass @default(NOT_SET)
  payrollTaxAnnualExemption Float
  payrollTaxEnabled         Boolean         @default(true)

  /// Official source the values were checked against (laws.gov.vg, bvissb.vg, vinhi.vg, IRD).
  sourceUrl  String    @default("")
  /// When the values were last compared against the official source.
  verifiedAt DateTime?
  verifiedBy String    @default("")
  /// Owner / qualified BVI payroll-professional sign-off before live use.
  approvedAt DateTime?
  approvedBy String    @default("")

  @@unique([orgId, effectiveYear])
  @@index([effectiveYear])
  @@index([orgId])
}

/// Database-backed rate limiting for authentication endpoints
/// (sign-in attempts per IP+email, password-reset request intervals).
/// Replaces the previous in-memory maps so limits survive restarts and
/// work when more than one API process is running.
model AuthRateLimit {
  id      String   @id @default(cuid())
  /// Unique bucket key, e.g. "login:192.168.1.1:user@example.com" or "reset:user@example.com".
  key     String   @unique
  count   Int      @default(0)
  /// Attempts after this instant start a new window.
  resetAt DateTime

  @@index([resetAt])
}

/// Opening year-to-date payroll balances for employees whose pay history
/// predates this system (imported from a previous payroll provider).
/// `gross` feeds the payroll-tax annual-exemption calculation so mid-year
/// migrations tax the remainder of the year correctly; the other components
/// are kept for audit and future register/reconciliation reports.
model PayrollYtdOpeningBalance {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Calendar year these opening balances apply to.
  year               Int
  gross              Float    @default(0)
  nhi                Float    @default(0)
  ssb                Float    @default(0)
  incomeTax          Float    @default(0)
  payrollTax         Float    @default(0)
  employerNhi        Float    @default(0)
  employerSsb        Float    @default(0)
  employerPayrollTax Float    @default(0)
  net                Float    @default(0)
  /// How the balance was recorded, e.g. "csv-import" or "manual".
  source             String   @default("csv-import")
  notes              String   @default("")
  importedBy         String   @default("")
  /// Owning organization (Batch 12).
  orgId              String

  @@unique([employeeId, year])
  @@index([year])
  @@index([orgId])
}

/// Leave policy: maps a staff-request type to a paid/unpaid leave scheme with
/// an optional annual allowance (0 = untracked). Approved requests consume
/// the allowance; unpaid-policy requests reduce fixed-basis pay pro-rata.
model LeavePolicy {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  /// Stable machine code, e.g. ANNUAL, SICK, UNPAID.
  code                String
  name                String
  /// Staff-request type whose approved requests count against this policy.
  requestType         StaffRequestType
  paid                Boolean          @default(true)
  /// Business days per calendar year per employee; 0 means untracked/unlimited.
  annualAllowanceDays Float            @default(0)
  active              Boolean          @default(true)
  sortOrder           Int              @default(0)
  /// Owning organization (Batch 12).
  orgId               String

  @@unique([orgId, code])
  @@unique([orgId, requestType])
  @@index([orgId])
}

// --- Financial statements + year-end close (Batch 15) ---
// Snapshots freeze a computed statement (params + payload + hash) so exports
// always reproduce exactly what was locked. The year-end close moves the
// year's revenue/expense balances into Retained Earnings through one closing
// journal, behind draft -> reviewed -> approved -> posted with signature;
// corrections are revisions that supersede, never edits.

enum ReportSnapshotType {
  profit_loss
  balance_sheet
  cash_flow
  changes_in_equity
  aging
  payroll_liabilities
  annual_return
}

/// An immutable, reproducible statement snapshot. Exports are generated from
/// the stored payload, never recomputed, so they always match what was locked.
model ReportSnapshot {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  type            ReportSnapshotType
  label           String             @default("")
  /// Statement parameters (from/to/asOf/compare flag).
  paramsJson      Json
  /// Full computed statement payload.
  payloadJson     Json
  /// sha256 of the canonical payload — tamper check.
  hash            String
  createdByUserId String?
  /// Owning organization (Batch 12).
  orgId           String

  @@index([orgId, type])
}

enum YearEndCloseStatus {
  draft
  reviewed
  approved
  /// Closing journal posted; signature recorded.
  posted
  /// Replaced by a newer revision (never edited in place).
  superseded
}

model YearEndClose {
  id                    String             @id @default(cuid())
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  year                  Int
  status                YearEndCloseStatus @default(draft)
  /// Closing journal lines preview computed at draft time (per-account).
  closingPreviewJson    Json?
  closingJournalEntryId String?
  reviewedByUserId      String?
  reviewedAt            DateTime?
  reviewNote            String             @default("")
  approvedByUserId      String?
  approvedAt            DateTime?
  postedAt              DateTime?
  postedByUserId        String?
  /// Sign-off text recorded at posting (typed signature).
  signatureText         String             @default("")
  /// Revision chain: this close supersedes revisionOf when posted.
  revisionOfId          String?
  revisionOf            YearEndClose?      @relation("YearEndCloseRevision", fields: [revisionOfId], references: [id], onDelete: SetNull)
  revisions             YearEndClose[]     @relation("YearEndCloseRevision")
  supersededById        String?
  revisionReason        String             @default("")
  createdByUserId       String?
  /// Owning organization (Batch 12).
  orgId                 String

  @@index([orgId, year])
}

// --- Accounting migration safety (Batch 17) ---
// Lifecycle: uploaded -> inventoried -> mapped -> validated -> approved ->
// importing -> reconciled -> accepted. Failure exits: rejected (validation),
// failed (commit error, zero partial data), reversed (post-commit undo).
// A commit is a single DB transaction: destination documents + journals +
// ExternalSourceRef lineage + row outcomes all land or none do.

enum ImportBatchStatus {
  uploaded
  inventoried
  mapped
  validated
  approved
  importing
  reconciled
  accepted
  rejected
  failed
  reversed
}

/// One legacy-system migration attempt (e.g. a QuickBooks export set).
model AccountingImportBatch {
  id                      String            @id @default(cuid())
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  /// quickbooks | xero | wave | excel_generic (adapters are Batch 18).
  sourceSystem            String            @default("excel_generic")
  /// full_detail imports everything importable; cutover imports master data,
  /// open documents, and opening balances only (history via opening balances).
  migrationMode           String            @default("full_detail")
  status                  ImportBatchStatus @default(uploaded)
  label                   String            @default("")
  /// Column mapping per import type, chosen at the mapped step.
  mappingJson             Json?
  approvedByUserId        String?
  approvedAt              DateTime?
  committedAt             DateTime?
  committedByUserId       String?
  reversedAt              DateTime?
  reversedByUserId        String?
  reversalReason          String            @default("")
  errorSummary            String            @default("")
  /// Batch 18: typed sign-off on the migration exception report.
  exceptionSignature      String            @default("")
  exceptionSignedByUserId String?
  exceptionSignedAt       DateTime?
  createdByUserId         String?
  /// Owning organization.
  orgId                   String

  files           AccountingImportFile[]
  reconciliations MigrationReconciliation[]

  @@index([orgId, status])
}

/// One uploaded source file inside a batch. Content-hash + private storage key
/// make the upload auditable and re-inventoriable.
model AccountingImportFile {
  id              String                @id @default(cuid())
  createdAt       DateTime              @default(now())
  batchId         String
  batch           AccountingImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  fileName        String
  /// customers|vendors|accounts|products|invoices|bills|expenses|payments|deposits|opening_balances
  /// + Batch 18: journal_entries|bill_payments|sales_receipts|transfers|estimates|purchase_orders|
  /// credit_memos|classes|locations|projects|product_categories|time_activities|attachment
  importType      String
  /// Batch 18: final disposition — pending|imported|archived|unsupported.
  disposition     String                @default("pending")
  dispositionNote String                @default("")
  sha256          String
  sizeBytes       Int
  /// Key in the private document storage (S3/R2 or local disk fallback).
  storageKey      String                @default("")
  rowCount        Int                   @default(0)
  validCount      Int                   @default(0)
  invalidCount    Int                   @default(0)
  committedCount  Int                   @default(0)
  /// Owning organization.
  orgId           String

  rows AccountingImportRow[]

  @@index([orgId, batchId])
  @@index([batchId])
}

/// One parsed source row with its validation and destination lineage.
model AccountingImportRow {
  id              String               @id @default(cuid())
  createdAt       DateTime             @default(now())
  fileId          String
  file            AccountingImportFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  /// 1-based row number in the source file (header excluded).
  rowIndex        Int
  payloadJson     Json
  /// Stable idempotency key derived from source ids or normalized content.
  sourceRef       String               @default("")
  /// pending|valid|invalid|committed|skipped_duplicate
  status          String               @default("pending")
  errorMessage    String               @default("")
  /// Destination model name (Customer, Invoice, JournalEntry, ...) once committed.
  destinationType String               @default("")
  destinationId   String               @default("")
  /// Owning organization.
  orgId           String

  @@unique([fileId, rowIndex])
  @@index([orgId, fileId])
  @@index([orgId, sourceRef])
}

/// Cross-system lineage: "legacy X with id Y became our Z". The unique key is
/// org-scoped so two tenants importing the same legacy file never collide.
model ExternalSourceRef {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  sourceSystem    String
  /// customer|vendor|account|product|invoice|bill|expense|payment|deposit|journal
  sourceType      String
  sourceId        String
  destinationType String
  destinationId   String
  batchId         String?
  /// Owning organization.
  orgId           String

  @@unique([orgId, sourceSystem, sourceType, sourceId])
  @@index([orgId, destinationType, destinationId])
  @@index([batchId])
}

/// Post-commit proof that what landed matches what the source claimed:
/// counts, totals, AR/AP balances. Discrepancies must be accepted explicitly.
model MigrationReconciliation {
  id               String                @id @default(cuid())
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  batchId          String
  batch            AccountingImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  /// count|total|trial_balance|ar_balance|ap_balance
  checkType        String
  scope            String                @default("")
  expected         Float                 @default(0)
  actual           Float                 @default(0)
  /// pending|matched|discrepancy|accepted
  status           String                @default("pending")
  note             String                @default("")
  acceptedByUserId String?
  acceptedAt       DateTime?
  /// Owning organization.
  orgId            String

  @@index([orgId, batchId])
  @@index([batchId])
}

/// A binary artifact kept from the legacy system (attachment, statement scan,
/// export ZIP member). Stored in private document storage with its hash.
model LegacyDocument {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  batchId     String?
  fileName    String
  sha256      String
  sizeBytes   Int
  contentType String   @default("")
  storageKey  String
  /// Optional link to the destination record it supports (Invoice, Bill...).
  linkedType  String   @default("")
  linkedId    String   @default("")
  /// Owning organization.
  orgId       String

  @@index([orgId, batchId])
  @@index([orgId, linkedType, linkedId])
}

// ---------------------------------------------------------------------------
// Batch 19 — HR structure: departments, positions, cost centres, locations,
// work schedules, effective-dated contracts (career history), assets.
// HR department / accounting cost centre / customer job / operational site
// stay distinct masters; mapping between them is optional and explicit.
// ---------------------------------------------------------------------------

enum EmploymentType {
  full_time
  part_time
  casual
  fixed_term
}

/// HR org unit. Hierarchy via parentId; independent from accounting cost centres.
model Department {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  code      String
  name      String
  parentId  String?
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Department[] @relation("DepartmentHierarchy")
  active    Boolean      @default(true)
  /// Owning organization (Batch 19).
  orgId     String

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([orgId, code])
  @@index([parentId])
  @@index([orgId])
}

/// Job position master (structured replacement for the free-text Employee.role).
model Position {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  code      String
  name      String
  active    Boolean  @default(true)
  orgId     String

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// Accounting/reporting allocation dimension. Optionally mapped to a GL account;
/// distinct from HR departments and operational sites.
model CostCentre {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  code        String
  name        String
  glAccountId String?
  glAccount   Account? @relation(fields: [glAccountId], references: [id], onDelete: SetNull)
  active      Boolean  @default(true)
  orgId       String

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// Operational site master (structured replacement for the free-text Employee.defaultSite).
/// Customer sites/jobs used on work assignments remain separate.
model Location {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  code      String
  name      String
  address   String   @default("")
  active    Boolean  @default(true)
  orgId     String

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([orgId, code])
  @@index([orgId])
}

/// Reusable weekly work pattern (e.g. Mon–Fri 8h). Leave Policy v2 (Batch 20)
/// consumes this; daily site assignments stay on WorkAssignment.
model WorkSchedule {
  id                   String   @id @default(cuid())
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  name                 String
  description          String   @default("")
  /// Weekly pattern: [{ "day": "mon"|...|"sun", "hours": 8 }].
  pattern              Json     @default("[]")
  standardHoursPerWeek Float    @default(0)
  active               Boolean  @default(true)
  orgId                String

  employees Employee[]
  contracts EmploymentContract[]

  @@unique([orgId, name])
  @@index([orgId])
}

/// Effective-dated employment terms — the career ledger. History is immutable:
/// corrections are new effective-dated records, never overwrites. The Employee's
/// current assignment FKs mirror the latest record for fast reads.
model EmploymentContract {
  id              String         @id @default(cuid())
  createdAt       DateTime       @default(now())
  employeeId      String
  employee        Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  employmentType  EmploymentType @default(full_time)
  departmentId    String?
  department      Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId      String?
  position        Position?      @relation(fields: [positionId], references: [id], onDelete: SetNull)
  costCentreId    String?
  costCentre      CostCentre?    @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  locationId      String?
  location        Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workScheduleId  String?
  workSchedule    WorkSchedule?  @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  managerId       String?
  manager         Employee?      @relation("ContractManager", fields: [managerId], references: [id], onDelete: SetNull)
  basePayType     PayBasis?
  dailyRate       Float?
  hourlyRate      Float?
  fixedPay        Float?
  notes           String         @default("")
  createdByUserId String?
  /// Owning organization (Batch 19).
  orgId           String

  @@index([employeeId, effectiveFrom])
  @@index([orgId])
}

/// Issued company property (uniforms, keys, phones) with return tracking.
model EmployeeAsset {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  assetTag     String    @default("")
  serialNumber String    @default("")
  condition    String    @default("")
  issuedAt     DateTime
  returnedAt   DateTime?
  notes        String    @default("")
  /// Owning organization (Batch 19).
  orgId        String

  @@index([employeeId, returnedAt])
  @@index([orgId])
}
