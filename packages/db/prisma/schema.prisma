generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production, staging, and CI use PostgreSQL with Prisma migrations.
  // For local SQLite fallback, use prisma/schema.sqlite.prisma explicitly.
  provider = "postgresql"
}

/// Matches master plan Task 4 role list.
enum Role {
  platform_owner
  hr_admin
  payroll_admin
  finance_admin
  operations_manager
  site_supervisor
  employee_tracker_user
}

/// User lifecycle; only `active` can obtain a valid session.
enum UserStatus {
  invited
  active
  suspended
  deactivated
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  /// Lowercased, trimmed; used for uniqueness and invite matching (nullable only before backfill).
  emailCanonical            String?                  @unique
  passwordHash              String
  name                      String
  /// Only `active` can sign in. Managed by platform_owner via admin API.
  status                    UserStatus               @default(active)
  /// Bumped to invalidate all JWTs (password / privilege / deactivation, etc.).
  tokenVersion              Int                      @default(0)
  /// When set, this login is the employee-tracker (mobile) account for that employee.
  employeeId                String?                  @unique
  employee                  Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  roles                     UserRole[]
  auditLogs                 AuditLog[]               @relation("AuditActor")
  invitations               UserInvitation[]
  passwordResetTokens       PasswordResetToken[]
  documentsUploaded         EmployeeDocument[]       @relation("DocumentUploader")
  staffRequestsReviewed     StaffRequest[]           @relation("StaffRequestReviewer")
  workAssignmentsCreated    WorkAssignment[]         @relation("WorkAssignmentCreator")
  staffAnnouncementsCreated StaffAnnouncement[]      @relation("StaffAnnouncementCreator")
  notificationLogsReceived  NotificationLog[]        @relation("NotificationRecipientUser")
  /// Cross-org break-glass support access; every use is audit-logged (Batch 12).
  isPlatformSupport         Boolean                  @default(false)
  memberships               OrganizationMembership[]

  @@index([status])
}

enum OrganizationStatus {
  active
  suspended
}

/// A tenant company. All business data carries an orgId pointing here (scalar
/// only for Batch 12; FK hardening is a follow-up).
model Organization {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  orgId        String
  userId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// One-time expiring invite; `tokenHash` is bcrypt of the full raw token (id:secret) shown once in dev.
model UserInvitation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  /// Org the invited user will join on acceptance (Batch 12).
  orgId      String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  /// Owning organization (Batch 12).
  orgId       String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([orgId])
}

/// Payroll pay basis (matches legacy browser app).
enum PayBasis {
  daily
  hourly
  fixed
}

enum PaySchedule {
  weekly
  biweekly
  monthly
}

enum TimeEntryStatus {
  draft
  submitted
  approved
  paid
}

enum PayRunStatus {
  draft
  finalized
  exported
  paid
  void
}

model DeductionTemplate {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  name           String
  nhiRate        Float       @default(0)
  ssbRate        Float       @default(0)
  incomeTaxRate  Float       @default(0)
  applyNhi       Boolean     @default(true)
  applySsb       Boolean     @default(true)
  applyIncomeTax Boolean     @default(false)
  employees      Employee[]
  timeEntries    TimeEntry[]
  /// Owning organization (Batch 12).
  orgId          String

  @@index([orgId])
}

/// HR / payroll document attachment (soft-delete only).
enum EmployeeDocumentType {
  PHOTO
  WORK_PERMIT_CARD
  NHI_CARD
  ID_CARD
  CONTRACT
  OTHER
}

enum PayrollTaxClass {
  NOT_SET
  CLASS_1
  CLASS_2
}

enum WorkAuthorizationStatus {
  NOT_SPECIFIED
  WORK_PERMIT
  BELONGER
  RESIDENT
  BV_ISLANDER
}

model Employee {
  id                            String                  @id @default(cuid())
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  fullName                      String
  sex                           String                  @default("")
  role                          String                  @default("")
  defaultSite                   String                  @default("")
  phone                         String                  @default("")
  email                         String                  @default("")
  /// Storage object key for the current profile image, e.g. `employees/{id}/profile-{cuid}.jpg`.
  profilePhotoPath              String?
  /// Sensitive — not exposed in list APIs or employee-tracker; audit logs must redact.
  socialSecurityNumber          String                  @default("")
  nationalHealthInsuranceNumber String                  @default("")
  nhiUnemployedSpouse           Boolean                 @default(false)
  inlandRevenueDepartmentNumber String                  @default("")
  employmentStartDate           DateTime?
  employmentEndDate             DateTime?
  workAuthorizationStatus       WorkAuthorizationStatus @default(NOT_SPECIFIED)
  workPermitNumber              String                  @default("")
  workPermitExpiryDate          DateTime?
  basePayType                   PayBasis                @default(daily)
  dailyRate                     Float                   @default(0)
  hourlyRate                    Float                   @default(0)
  overtimeRate                  Float                   @default(0)
  fixedPay                      Float                   @default(0)
  standardDays                  Float                   @default(0)
  standardHours                 Float                   @default(0)
  paySchedule                   PaySchedule             @default(monthly)
  active                        Boolean                 @default(true)
  /// Applies the employer's annual payroll-tax exemption to this employee.
  payrollTaxExemptionEnabled    Boolean                 @default(true)
  notes                         String                  @default("")
  /// Batch 19 HR structure assignments. Legacy `role`/`defaultSite` strings are kept for display;
  /// these masters are the structured source going forward.
  departmentId                  String?
  department                    Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionId                    String?
  position                      Position?               @relation(fields: [positionId], references: [id], onDelete: SetNull)
  costCentreId                  String?
  costCentre                    CostCentre?             @relation(fields: [costCentreId], references: [id], onDelete: SetNull)
  locationId                    String?
  location                      Location?               @relation(fields: [locationId], references: [id], onDelete: SetNull)
  workScheduleId                String?
  workSchedule                  WorkSchedule?           @relation(fields: [workScheduleId], references: [id], onDelete: SetNull)
  managerId                     String?
  manager                       Employee?               @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                 Employee[]              @relation("EmployeeManager")
  managedContracts              EmploymentContract[]    @relation("ContractManager")
  contracts                     EmploymentContract[]
  assets                        EmployeeAsset[]
  templateId                    String
  template                      DeductionTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Owning organization (Batch 12).
  orgId                         String

  timeEntries TimeEntry[]
  payRunItems PayRunItem[]

  ytdOpeningBalances PayrollYtdOpeningBalance[]
  linkedUser         User?
  documents          EmployeeDocument[]
  staffRequests      StaffRequest[]
  workAssignments    WorkAssignment[]
  staffQuizAttempts  StaffQuizAttempt[]
  rewardLedgers      RewardLedger[]
  notificationLogs   NotificationLog[]          @relation("NotificationLogEmployee")

  @@index([templateId])
  @@index([active])
  @@index([fullName])
  @@index([email])
  @@index([paySchedule, active])
  @@index([departmentId])
  @@index([costCentreId])
  @@index([managerId])
  @@index([orgId])
}

/// Phase 2 — Staff Hub request types submitted by employees.
enum StaffRequestType {
  JOB_LETTER
  TIME_OFF
  SICK_LEAVE
  UNPAID_LEAVE
  PROFILE_UPDATE
  SUPPLIES_REQUEST
  EQUIPMENT_UNIFORM_REQUEST
  INCIDENT_REPORT
  DAMAGE_REPORT
}

/// Phase 2 — Staff Hub request lifecycle.
enum StaffRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  COMPLETED
  CANCELLED
}

/// Employee self-service request for letters, time off, supplies, incident
/// reports, profile changes, etc. Sensitive HR identifiers (SSN, NHI, IRD)
/// must NEVER be stored in `requestedContactUpdate` or any other field of
/// this model — those live on `Employee` and are managed by HR admins only.
model StaffRequest {
  id                     String             @id @default(cuid())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type                   StaffRequestType
  status                 StaffRequestStatus @default(SUBMITTED)
  subject                String?
  startDate              DateTime?
  endDate                DateTime?
  reason                 String?
  details                String?
  /// JSON payload for PROFILE_UPDATE only — restricted to non-sensitive
  /// contact fields (phone, address, emergency contact, uniform size).
  requestedContactUpdate Json?
  reviewNote             String?
  reviewedByUserId       String?
  reviewedBy             User?              @relation("StaffRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  cancelledAt            DateTime?
  /// Owning organization (Batch 12).
  orgId                  String

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([employeeId, status])
  @@index([orgId])
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             EmployeeDocumentType
  fileName         String
  mimeType         String
  sizeBytes        Int
  /// Storage object key resolved by the API document storage provider.
  storagePath      String
  uploadedAt       DateTime             @default(now())
  /// Soft delete — never hard-delete in normal flow.
  deletedAt        DateTime?
  uploadedByUserId String?
  uploadedBy       User?                @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  /// Optional expiry (permit cards, contracts) — feeds the Batch 19 expiry reminders.
  expiryDate       DateTime?
  /// Owning organization (Batch 12).
  orgId            String

  @@index([employeeId, deletedAt])
  @@index([type])
  @@index([orgId])
}

/// Monthly timesheet line (legacy payroll app shape; multiple rows per employee/month allowed for different sites).
model TimeEntry {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month               String
  periodStart         DateTime?
  periodEnd           DateTime?
  site                String            @default("")
  startTime           String            @default("")
  endTime             String            @default("")
  breakMinutes        Int               @default(0)
  status              TimeEntryStatus   @default(draft)
  daysWorked          Float             @default(0)
  hoursWorked         Float             @default(0)
  overtimeHours       Float             @default(0)
  flatGross           Float             @default(0)
  bonus               Float             @default(0)
  allowance           Float             @default(0)
  advanceDeduction    Float             @default(0)
  withdrawalDeduction Float             @default(0)
  loanDeduction       Float             @default(0)
  otherDeduction      Float             @default(0)
  templateId          String
  template            DeductionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  applyNhi            Boolean           @default(true)
  applySsb            Boolean           @default(true)
  applyIncomeTax      Boolean           @default(false)
  notes               String            @default("")
  /// Owning organization (Batch 12).
  orgId               String

  @@index([employeeId, month])
  @@index([month])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([orgId])
}

model PayPeriod {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  label     String
  schedule  PaySchedule
  startDate DateTime
  endDate   DateTime
  payDate   DateTime?
  notes     String      @default("")
  runs      PayRun[]
  /// Owning organization (Batch 12).
  orgId     String

  @@unique([orgId, schedule, startDate, endDate])
  @@index([schedule, startDate])
  @@index([endDate])
  @@index([orgId])
}

model PayRun {
  id                  String          @id @default(cuid())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  // Not @unique: a period may have at most one ACTIVE (non-void) run, but a
  // voided run is kept for audit while a corrected run is created. The
  // "one active run per period" rule is enforced in the payroll service.
  periodId            String
  period              PayPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  status              PayRunStatus    @default(draft)
  notes               String          @default("")
  finalizedAt         DateTime?
  exportedAt          DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?
  /// Set when the run's NHI/SSB/payroll-tax liabilities were remitted (GL journal posted).
  statutoryRemittedAt DateTime?
  /// Immutable statutory/company settings used to calculate this run.
  statutorySnapshot   Json?
  items               PayRunItem[]
  exports             PayrollExport[]
  /// Owning organization (Batch 12).
  orgId               String

  @@index([status])
  @@index([periodId])
  @@index([orgId])
}

model PayRunItem {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  runId                String
  run                  PayRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName         String
  employeeRole         String      @default("")
  defaultSite          String      @default("")
  paySchedule          PaySchedule
  payBasis             PayBasis
  templateName         String      @default("")
  sourceEntryIds       Json?
  sourceSummary        Json?
  gross                Float       @default(0)
  nhi                  Float       @default(0)
  ssb                  Float       @default(0)
  incomeTax            Float       @default(0)
  payrollTax           Float       @default(0)
  employerNhi          Float       @default(0)
  employerSsb          Float       @default(0)
  employerPayrollTax   Float       @default(0)
  manualDeductions     Float       @default(0)
  totalDeductions      Float       @default(0)
  net                  Float       @default(0)
  daysWorked           Float       @default(0)
  hoursWorked          Float       @default(0)
  overtimeHours        Float       @default(0)
  bonus                Float       @default(0)
  allowance            Float       @default(0)
  flatGross            Float       @default(0)
  advanceDeduction     Float       @default(0)
  withdrawalDeduction  Float       @default(0)
  loanDeduction        Float       @default(0)
  otherDeduction       Float       @default(0)
  /// Approved unpaid-leave business days in this run's period and the pro-rated
  /// fixed-pay reduction already applied to `gross` (fixed-basis employees only;
  /// daily/hourly staff simply have no time entries on unpaid-leave days).
  unpaidLeaveDays      Float       @default(0)
  unpaidLeaveDeduction Float       @default(0)
  paystub              Paystub?
  /// Owning organization (Batch 12).
  orgId                String

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([orgId])
}

model Paystub {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payRunItemId String     @unique
  payRunItem   PayRunItem @relation(fields: [payRunItemId], references: [id], onDelete: Cascade)
  stubNumber   String
  issuedAt     DateTime   @default(now())
  payload      Json?
  /// Owning organization (Batch 12).
  orgId        String

  @@unique([orgId, stubNumber])
  @@index([orgId])
}

model PayrollExport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runId     String
  run       PayRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  format    String
  fileName  String
  contents  String
  /// Owning organization (Batch 12).
  orgId     String

  @@index([runId])
  @@index([orgId])
}

/// Organization-level payroll configuration (single row, id "singleton").
/// Surfaces the centralized BVI statutory config so it can be edited in admin
/// settings instead of living as hardcoded placeholders in code.
///
model OrgSettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Owning organization (Batch 12); one settings row per org.
  orgId     String   @unique

  /// Legal company name printed on paystubs and exports.
  companyLegalName          String @default("")
  companyAddress            String @default("")
  ssbEmployerNumber         String @default("")
  nhiEmployerNumber         String @default("")
  /// PNG data URL used only on authenticated statutory-form exports.
  statutorySignatureDataUrl String @default("")

  /// Filing identity + applicability (Batch 15, BVI filing support).
  companyRegistrationNumber  String    @default("")
  incorporationDate          DateTime?
  registeredAgentName        String    @default("")
  registeredOfficeAddress    String    @default("")
  /// Calendar month the financial year ends (12 = December).
  fiscalYearEndMonth         Int       @default(12)
  /// Applicability answers: does the company file a tax return + financial
  /// statements with Inland Revenue (annual-return exemption basis)?
  filesIrFinancialStatements Boolean   @default(false)
  annualReturnExemptionBasis String    @default("")

  /// Pay calendar defaults used when creating new pay periods.
  defaultPaySchedule   PaySchedule @default(monthly)
  defaultPayDayOfMonth Int         @default(0)

  /// BVI Social Security Board contribution (employee/employer split + ceiling).
  ssbEmployeeRate  Float   @default(0.04)
  ssbEmployerRate  Float   @default(0.045)
  ssbPeriodCeiling Float   @default(0)
  ssbAnnualCeiling Float   @default(53400)
  ssbEnabled       Boolean @default(true)

  /// BVI National Health Insurance contribution (employee/employer split + ceiling).
  nhiEmployeeRate  Float   @default(0.0375)
  nhiEmployerRate  Float   @default(0.0375)
  nhiPeriodCeiling Float   @default(0)
  nhiAnnualCeiling Float   @default(106800)
  nhiEnabled       Boolean @default(true)

  /// BVI payroll tax: employee withholding plus the employer's Class 1/2 share.
  payrollTaxEnabled         Boolean         @default(true)
  payrollTaxEmployeeRate    Float           @default(0.08)
  payrollTaxEmployerClass   PayrollTaxClass @default(NOT_SET)
  payrollTaxAnnualExemption Float           @default(10000)
  statutoryEffectiveYear    Int             @default(2026)
}

/// Finance master data (Phase 3 Task 9).
/// QuickBooks-style chart of accounts. `code` is the numeric account number
/// (e.g. "1000" Cash, "4000" Sales Revenue). `type` drives reporting
/// classification and which side increases the balance.
enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

/// Item kind for sellable / purchasable records.
enum ProductKind {
  service
  product
  bundle
}

model Account {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  code        String
  name        String
  type        AccountType
  subtype     String      @default("")
  description String      @default("")
  active      Boolean     @default(true)
  parentId    String?
  parent      Account?    @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]   @relation("AccountTree")
  /// Owning organization (Batch 12).
  orgId       String

  productsAsIncome  Product[] @relation("ProductIncome")
  productsAsExpense Product[] @relation("ProductExpense")

  invoiceLines       InvoiceLine[] @relation("InvoiceLineIncomeAccount")
  billLines          BillLine[]    @relation("BillLineExpenseAccount")
  paymentDeposits    Payment[]     @relation("PaymentDepositAccount")
  billPaymentSources BillPayment[] @relation("BillPaymentSourceAccount")
  expensesAsPayment  Expense[]     @relation("ExpensePaymentAccount")
  expenseLines       ExpenseLine[] @relation("ExpenseLineExpenseAccount")
  depositsAsBank     Deposit[]     @relation("DepositBankAccount")
  journalLines       JournalLine[]

  depositLines DepositLine[] @relation("DepositLineAccount")

  bankStatementImports BankStatementImport[] @relation("BankStatementImportAccount")
  bankReconciliations  BankReconciliation[]  @relation("BankReconciliationAccount")
  costCentres          CostCentre[]

  @@unique([orgId, code])
  @@index([type, active])
  @@index([parentId])
  @@index([name])
  @@index([orgId])
}

model Customer {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  displayName    String
  companyName    String   @default("")
  primaryContact String   @default("")
  email          String   @default("")
  phone          String   @default("")
  billingAddress String   @default("")
  taxId          String   @default("")
  notes          String   @default("")
  active         Boolean  @default(true)
  /// Owning organization (Batch 12).
  orgId          String

  invoices Invoice[]
  payments Payment[]

  @@unique([orgId, displayName])
  @@index([active])
  @@index([displayName])
  @@index([orgId])
}

model Supplier {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  displayName    String
  companyName    String   @default("")
  primaryContact String   @default("")
  email          String   @default("")
  phone          String   @default("")
  mailingAddress String   @default("")
  taxId          String   @default("")
  notes          String   @default("")
  active         Boolean  @default(true)
  /// Owning organization (Batch 12).
  orgId          String

  bills        Bill[]
  billPayments BillPayment[]
  expenses     Expense[]

  @@unique([orgId, displayName])
  @@index([active])
  @@index([displayName])
  @@index([orgId])
}

model Product {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sku              String
  name             String
  kind             ProductKind @default(service)
  description      String      @default("")
  salesPrice       Float       @default(0)
  purchaseCost     Float       @default(0)
  taxable          Boolean     @default(false)
  active           Boolean     @default(true)
  incomeAccountId  String
  incomeAccount    Account     @relation("ProductIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  expenseAccountId String?
  expenseAccount   Account?    @relation("ProductExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
  orgId            String

  invoiceLines InvoiceLine[] @relation("InvoiceLineProduct")
  billLines    BillLine[]    @relation("BillLineProduct")

  @@unique([orgId, sku])
  @@index([kind, active])
  @@index([incomeAccountId])
  @@index([expenseAccountId])
  @@index([name])
  @@index([orgId])
}

/// Finance transactions (Phase 3 Task 10).
/// Document status drives invoice/bill lifecycle:
///   draft  -> editable, not yet issued
///   open   -> sent/received, awaiting payment
///   partial-> some payment applied
///   paid   -> balance zero
///   void   -> cancelled; excluded from AR/AP totals
enum TransactionStatus {
  draft
  open
  partial
  paid
  void
}

model Invoice {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  number       String
  customerId   String
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate    DateTime
  dueDate      DateTime?
  memo         String               @default("")
  status       TransactionStatus    @default(draft)
  subtotal     Float                @default(0)
  taxTotal     Float                @default(0)
  total        Float                @default(0)
  amountPaid   Float                @default(0)
  balance      Float                @default(0)
  sentAt       DateTime?
  voidedAt     DateTime?
  lines        InvoiceLine[]
  applications PaymentApplication[]
  /// Owning organization (Batch 12).
  orgId        String

  @@unique([orgId, number])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([orgId])
}

model InvoiceLine {
