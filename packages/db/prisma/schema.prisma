  locationAddress String?
  notes           String?
  status          WorkAssignmentStatus @default(SCHEDULED)
  createdByUserId String?
  createdBy       User?                @relation("WorkAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
