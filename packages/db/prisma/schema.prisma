  question     String
  choices      Json
  correctIndex Int
  explanation  String             @default("")
  active       Boolean            @default(true)
  attempts     StaffQuizAttempt[]
  /// Owning organization (Batch 12).
  orgId        String

  @@index([orgId])
}

model StaffQuizAttempt {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  questionId    String
  question      StaffQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int
  correct       Boolean
  pointsAwarded Int               @default(0)
  /// Owning organization (Batch 12).
  orgId         String

  @@index([employeeId, createdAt])
  @@index([questionId])
  @@index([orgId])
}

model RewardLedger {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
