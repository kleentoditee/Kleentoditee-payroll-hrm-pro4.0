  @@index([date])
  @@index([orgId])
}

enum StaffAnnouncementCategory {
  GENERAL
  SAFETY
  HOLIDAY
  POLICY
  WEATHER
  PAYROLL
  SCHEDULE
}

enum StaffAnnouncementAudience {
  ALL
  EMPLOYEES
