generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Production, staging, and CI use PostgreSQL with Prisma migrations.
  // For local SQLite fallback, use prisma/schema.sqlite.prisma explicitly.
  provider = "postgresql"
}

/// Matches master plan Task 4 role list.
enum Role {
  platform_owner
  hr_admin
  payroll_admin
  finance_admin
  operations_manager
  site_supervisor
  employee_tracker_user
}

/// User lifecycle; only `active` can obtain a valid session.
enum UserStatus {
  invited
  active
  suspended
  deactivated
}

model User {
  id                        String                   @id @default(cuid())
  email                     String                   @unique
  /// Lowercased, trimmed; used for uniqueness and invite matching (nullable only before backfill).
  emailCanonical            String?                  @unique
  passwordHash              String
  name                      String
  /// Only `active` can sign in. Managed by platform_owner via admin API.
  status                    UserStatus               @default(active)
  /// Bumped to invalidate all JWTs (password / privilege / deactivation, etc.).
  tokenVersion              Int                      @default(0)
  /// When set, this login is the employee-tracker (mobile) account for that employee.
  employeeId                String?                  @unique
  employee                  Employee?                @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  roles                     UserRole[]
  auditLogs                 AuditLog[]               @relation("AuditActor")
  invitations               UserInvitation[]
  passwordResetTokens       PasswordResetToken[]
  documentsUploaded         EmployeeDocument[]       @relation("DocumentUploader")
  staffRequestsReviewed     StaffRequest[]           @relation("StaffRequestReviewer")
  workAssignmentsCreated    WorkAssignment[]         @relation("WorkAssignmentCreator")
  staffAnnouncementsCreated StaffAnnouncement[]      @relation("StaffAnnouncementCreator")
  notificationLogsReceived  NotificationLog[]        @relation("NotificationRecipientUser")
  /// Cross-org break-glass support access; every use is audit-logged (Batch 12).
  isPlatformSupport         Boolean                  @default(false)
  memberships               OrganizationMembership[]

  @@index([status])
}

enum OrganizationStatus {
  active
  suspended
}

/// A tenant company. All business data carries an orgId pointing here (scalar
/// only for Batch 12; FK hardening is a follow-up).
model Organization {
  id        String             @id @default(cuid())
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(active)

  memberships OrganizationMembership[]
}

model OrganizationMembership {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now())
  orgId        String
  userId       String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// One-time expiring invite; `tokenHash` is bcrypt of the full raw token (id:secret) shown once in dev.
model UserInvitation {
  id         String    @id @default(cuid())
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  /// Org the invited user will join on acceptance (Batch 12).
  orgId      String
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  @@index([orgId])
  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  role   Role
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
}

model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  metadata    Json?
  /// Owning organization (Batch 12).
  orgId       String?

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([orgId])
}

/// Payroll pay basis (matches legacy browser app).
enum PayBasis {
  daily
  hourly
  fixed
}

enum PaySchedule {
  weekly
  biweekly
  monthly
}

enum TimeEntryStatus {
  draft
  submitted
  approved
  paid
}

enum PayRunStatus {
  draft
  finalized
  exported
  paid
  void
}

model DeductionTemplate {
  id             String      @id @default(cuid())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  name           String
  nhiRate        Float       @default(0)
  ssbRate        Float       @default(0)
  incomeTaxRate  Float       @default(0)
  applyNhi       Boolean     @default(true)
  applySsb       Boolean     @default(true)
  applyIncomeTax Boolean     @default(false)
  employees      Employee[]
  timeEntries    TimeEntry[]
  /// Owning organization (Batch 12).
  orgId          String

  @@index([orgId])
}

/// HR / payroll document attachment (soft-delete only).
enum EmployeeDocumentType {
  PHOTO
  WORK_PERMIT_CARD
  NHI_CARD
  ID_CARD
  CONTRACT
  OTHER
}

enum PayrollTaxClass {
  NOT_SET
  CLASS_1
  CLASS_2
}

enum WorkAuthorizationStatus {
  NOT_SPECIFIED
  WORK_PERMIT
  BELONGER
  RESIDENT
  BV_ISLANDER
}

model Employee {
  id                            String                  @id @default(cuid())
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  fullName                      String
  sex                           String                  @default("")
  role                          String                  @default("")
  defaultSite                   String                  @default("")
  phone                         String                  @default("")
  email                         String                  @default("")
  /// Storage object key for the current profile image, e.g. `employees/{id}/profile-{cuid}.jpg`.
  profilePhotoPath              String?
  /// Sensitive — not exposed in list APIs or employee-tracker; audit logs must redact.
  socialSecurityNumber          String                  @default("")
  nationalHealthInsuranceNumber String                  @default("")
  nhiUnemployedSpouse           Boolean                 @default(false)
  inlandRevenueDepartmentNumber String                  @default("")
  employmentStartDate           DateTime?
  employmentEndDate             DateTime?
  workAuthorizationStatus       WorkAuthorizationStatus @default(NOT_SPECIFIED)
  workPermitNumber              String                  @default("")
  workPermitExpiryDate          DateTime?
  basePayType                   PayBasis                @default(daily)
  dailyRate                     Float                   @default(0)
  hourlyRate                    Float                   @default(0)
  overtimeRate                  Float                   @default(0)
  fixedPay                      Float                   @default(0)
  standardDays                  Float                   @default(0)
  standardHours                 Float                   @default(0)
  paySchedule                   PaySchedule             @default(monthly)
  active                        Boolean                 @default(true)
  /// Applies the employer's annual payroll-tax exemption to this employee.
  payrollTaxExemptionEnabled    Boolean                 @default(true)
  notes                         String                  @default("")
  templateId                    String
  template                      DeductionTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// Owning organization (Batch 12).
  orgId                         String

  timeEntries TimeEntry[]
  payRunItems PayRunItem[]

  ytdOpeningBalances PayrollYtdOpeningBalance[]
  linkedUser         User?
  documents          EmployeeDocument[]
  staffRequests      StaffRequest[]
  workAssignments    WorkAssignment[]
  staffQuizAttempts  StaffQuizAttempt[]
  rewardLedgers      RewardLedger[]
  notificationLogs   NotificationLog[]          @relation("NotificationLogEmployee")

  @@index([templateId])
  @@index([active])
  @@index([fullName])
  @@index([email])
  @@index([paySchedule, active])
  @@index([orgId])
}

/// Phase 2 — Staff Hub request types submitted by employees.
enum StaffRequestType {
  JOB_LETTER
  TIME_OFF
  SICK_LEAVE
  UNPAID_LEAVE
  PROFILE_UPDATE
  SUPPLIES_REQUEST
  EQUIPMENT_UNIFORM_REQUEST
  INCIDENT_REPORT
  DAMAGE_REPORT
}

/// Phase 2 — Staff Hub request lifecycle.
enum StaffRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DENIED
  COMPLETED
  CANCELLED
}

/// Employee self-service request for letters, time off, supplies, incident
/// reports, profile changes, etc. Sensitive HR identifiers (SSN, NHI, IRD)
/// must NEVER be stored in `requestedContactUpdate` or any other field of
/// this model — those live on `Employee` and are managed by HR admins only.
model StaffRequest {
  id                     String             @id @default(cuid())
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  employeeId             String
  employee               Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type                   StaffRequestType
  status                 StaffRequestStatus @default(SUBMITTED)
  subject                String?
  startDate              DateTime?
  endDate                DateTime?
  reason                 String?
  details                String?
  /// JSON payload for PROFILE_UPDATE only — restricted to non-sensitive
  /// contact fields (phone, address, emergency contact, uniform size).
  requestedContactUpdate Json?
  reviewNote             String?
  reviewedByUserId       String?
  reviewedBy             User?              @relation("StaffRequestReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt             DateTime?
  cancelledAt            DateTime?
  /// Owning organization (Batch 12).
  orgId                  String

  @@index([employeeId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
  @@index([employeeId, status])
  @@index([orgId])
}

model EmployeeDocument {
  id               String               @id @default(cuid())
  employeeId       String
  employee         Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type             EmployeeDocumentType
  fileName         String
  mimeType         String
  sizeBytes        Int
  /// Storage object key resolved by the API document storage provider.
  storagePath      String
  uploadedAt       DateTime             @default(now())
  /// Soft delete — never hard-delete in normal flow.
  deletedAt        DateTime?
  uploadedByUserId String?
  uploadedBy       User?                @relation("DocumentUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
  orgId            String

  @@index([employeeId, deletedAt])
  @@index([type])
  @@index([orgId])
}

/// Monthly timesheet line (legacy payroll app shape; multiple rows per employee/month allowed for different sites).
model TimeEntry {
  id                  String            @id @default(cuid())
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  employeeId          String
  employee            Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  month               String
  periodStart         DateTime?
  periodEnd           DateTime?
  site                String            @default("")
  startTime           String            @default("")
  endTime             String            @default("")
  breakMinutes        Int               @default(0)
  status              TimeEntryStatus   @default(draft)
  daysWorked          Float             @default(0)
  hoursWorked         Float             @default(0)
  overtimeHours       Float             @default(0)
  flatGross           Float             @default(0)
  bonus               Float             @default(0)
  allowance           Float             @default(0)
  advanceDeduction    Float             @default(0)
  withdrawalDeduction Float             @default(0)
  loanDeduction       Float             @default(0)
  otherDeduction      Float             @default(0)
  templateId          String
  template            DeductionTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  applyNhi            Boolean           @default(true)
  applySsb            Boolean           @default(true)
  applyIncomeTax      Boolean           @default(false)
  notes               String            @default("")
  /// Owning organization (Batch 12).
  orgId               String

  @@index([employeeId, month])
  @@index([month])
  @@index([status])
  @@index([periodStart, periodEnd])
  @@index([orgId])
}

model PayPeriod {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  label     String
  schedule  PaySchedule
  startDate DateTime
  endDate   DateTime
  payDate   DateTime?
  notes     String      @default("")
  runs      PayRun[]
  /// Owning organization (Batch 12).
  orgId     String

  @@unique([orgId, schedule, startDate, endDate])
  @@index([schedule, startDate])
  @@index([endDate])
  @@index([orgId])
}

model PayRun {
  id                  String          @id @default(cuid())
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  // Not @unique: a period may have at most one ACTIVE (non-void) run, but a
  // voided run is kept for audit while a corrected run is created. The
  // "one active run per period" rule is enforced in the payroll service.
  periodId            String
  period              PayPeriod       @relation(fields: [periodId], references: [id], onDelete: Cascade)
  status              PayRunStatus    @default(draft)
  notes               String          @default("")
  finalizedAt         DateTime?
  exportedAt          DateTime?
  paidAt              DateTime?
  voidedAt            DateTime?
  /// Set when the run's NHI/SSB/payroll-tax liabilities were remitted (GL journal posted).
  statutoryRemittedAt DateTime?
  /// Immutable statutory/company settings used to calculate this run.
  statutorySnapshot   Json?
  items               PayRunItem[]
  exports             PayrollExport[]
  /// Owning organization (Batch 12).
  orgId               String

  @@index([status])
  @@index([periodId])
  @@index([orgId])
}

model PayRunItem {
  id                   String      @id @default(cuid())
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  runId                String
  run                  PayRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId           String
  employee             Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  employeeName         String
  employeeRole         String      @default("")
  defaultSite          String      @default("")
  paySchedule          PaySchedule
  payBasis             PayBasis
  templateName         String      @default("")
  sourceEntryIds       Json?
  sourceSummary        Json?
  gross                Float       @default(0)
  nhi                  Float       @default(0)
  ssb                  Float       @default(0)
  incomeTax            Float       @default(0)
  payrollTax           Float       @default(0)
  employerNhi          Float       @default(0)
  employerSsb          Float       @default(0)
  employerPayrollTax   Float       @default(0)
  manualDeductions     Float       @default(0)
  totalDeductions      Float       @default(0)
  net                  Float       @default(0)
  daysWorked           Float       @default(0)
  hoursWorked          Float       @default(0)
  overtimeHours        Float       @default(0)
  bonus                Float       @default(0)
  allowance            Float       @default(0)
  flatGross            Float       @default(0)
  advanceDeduction     Float       @default(0)
  withdrawalDeduction  Float       @default(0)
  loanDeduction        Float       @default(0)
  otherDeduction       Float       @default(0)
  /// Approved unpaid-leave business days in this run's period and the pro-rated
  /// fixed-pay reduction already applied to `gross` (fixed-basis employees only;
  /// daily/hourly staff simply have no time entries on unpaid-leave days).
  unpaidLeaveDays      Float       @default(0)
  unpaidLeaveDeduction Float       @default(0)
  paystub              Paystub?
  /// Owning organization (Batch 12).
  orgId                String

  @@unique([runId, employeeId])
  @@index([employeeId])
  @@index([orgId])
}

model Paystub {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  payRunItemId String     @unique
  payRunItem   PayRunItem @relation(fields: [payRunItemId], references: [id], onDelete: Cascade)
  stubNumber   String
  issuedAt     DateTime   @default(now())
  payload      Json?
  /// Owning organization (Batch 12).
  orgId        String

  @@unique([orgId, stubNumber])
  @@index([orgId])
}

model PayrollExport {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  runId     String
  run       PayRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  format    String
  fileName  String
  contents  String
  /// Owning organization (Batch 12).
  orgId     String

  @@index([runId])
  @@index([orgId])
}

/// Organization-level payroll configuration (single row, id "singleton").
/// Surfaces the centralized BVI statutory config so it can be edited in admin
/// settings instead of living as hardcoded placeholders in code.
///
model OrgSettings {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Owning organization (Batch 12); one settings row per org.
  orgId     String   @unique

  /// Legal company name printed on paystubs and exports.
  companyLegalName          String @default("")
  companyAddress            String @default("")
  ssbEmployerNumber         String @default("")
  nhiEmployerNumber         String @default("")
  /// PNG data URL used only on authenticated statutory-form exports.
  statutorySignatureDataUrl String @default("")

  /// Pay calendar defaults used when creating new pay periods.
  defaultPaySchedule   PaySchedule @default(monthly)
  defaultPayDayOfMonth Int         @default(0)

  /// BVI Social Security Board contribution (employee/employer split + ceiling).
  ssbEmployeeRate  Float   @default(0.04)
  ssbEmployerRate  Float   @default(0.045)
  ssbPeriodCeiling Float   @default(0)
  ssbAnnualCeiling Float   @default(53400)
  ssbEnabled       Boolean @default(true)

  /// BVI National Health Insurance contribution (employee/employer split + ceiling).
  nhiEmployeeRate  Float   @default(0.0375)
  nhiEmployerRate  Float   @default(0.0375)
  nhiPeriodCeiling Float   @default(0)
  nhiAnnualCeiling Float   @default(106800)
  nhiEnabled       Boolean @default(true)

  /// BVI payroll tax: employee withholding plus the employer's Class 1/2 share.
  payrollTaxEnabled         Boolean         @default(true)
  payrollTaxEmployeeRate    Float           @default(0.08)
  payrollTaxEmployerClass   PayrollTaxClass @default(NOT_SET)
  payrollTaxAnnualExemption Float           @default(10000)
  statutoryEffectiveYear    Int             @default(2026)
}

/// Finance master data (Phase 3 Task 9).
/// QuickBooks-style chart of accounts. `code` is the numeric account number
/// (e.g. "1000" Cash, "4000" Sales Revenue). `type` drives reporting
/// classification and which side increases the balance.
enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

/// Item kind for sellable / purchasable records.
enum ProductKind {
  service
  product
  bundle
}

model Account {
  id          String      @id @default(cuid())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  code        String
  name        String
  type        AccountType
  subtype     String      @default("")
  description String      @default("")
  active      Boolean     @default(true)
  parentId    String?
  parent      Account?    @relation("AccountTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Account[]   @relation("AccountTree")
  /// Owning organization (Batch 12).
  orgId       String

  productsAsIncome  Product[] @relation("ProductIncome")
  productsAsExpense Product[] @relation("ProductExpense")

  invoiceLines       InvoiceLine[] @relation("InvoiceLineIncomeAccount")
  billLines          BillLine[]    @relation("BillLineExpenseAccount")
  paymentDeposits    Payment[]     @relation("PaymentDepositAccount")
  billPaymentSources BillPayment[] @relation("BillPaymentSourceAccount")
  expensesAsPayment  Expense[]     @relation("ExpensePaymentAccount")
  expenseLines       ExpenseLine[] @relation("ExpenseLineExpenseAccount")
  depositsAsBank     Deposit[]     @relation("DepositBankAccount")
  journalLines       JournalLine[]

  @@unique([orgId, code])
  @@index([type, active])
  @@index([parentId])
  @@index([name])
  @@index([orgId])
}

model Customer {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  displayName    String
  companyName    String   @default("")
  primaryContact String   @default("")
  email          String   @default("")
  phone          String   @default("")
  billingAddress String   @default("")
  taxId          String   @default("")
  notes          String   @default("")
  active         Boolean  @default(true)
  /// Owning organization (Batch 12).
  orgId          String

  invoices Invoice[]
  payments Payment[]

  @@unique([orgId, displayName])
  @@index([active])
  @@index([displayName])
  @@index([orgId])
}

model Supplier {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  displayName    String
  companyName    String   @default("")
  primaryContact String   @default("")
  email          String   @default("")
  phone          String   @default("")
  mailingAddress String   @default("")
  taxId          String   @default("")
  notes          String   @default("")
  active         Boolean  @default(true)
  /// Owning organization (Batch 12).
  orgId          String

  bills        Bill[]
  billPayments BillPayment[]
  expenses     Expense[]

  @@unique([orgId, displayName])
  @@index([active])
  @@index([displayName])
  @@index([orgId])
}

model Product {
  id               String      @id @default(cuid())
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  sku              String
  name             String
  kind             ProductKind @default(service)
  description      String      @default("")
  salesPrice       Float       @default(0)
  purchaseCost     Float       @default(0)
  taxable          Boolean     @default(false)
  active           Boolean     @default(true)
  incomeAccountId  String
  incomeAccount    Account     @relation("ProductIncome", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  expenseAccountId String?
  expenseAccount   Account?    @relation("ProductExpense", fields: [expenseAccountId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
  orgId            String

  invoiceLines InvoiceLine[] @relation("InvoiceLineProduct")
  billLines    BillLine[]    @relation("BillLineProduct")

  @@unique([orgId, sku])
  @@index([kind, active])
  @@index([incomeAccountId])
  @@index([expenseAccountId])
  @@index([name])
  @@index([orgId])
}

/// Finance transactions (Phase 3 Task 10).
/// Document status drives invoice/bill lifecycle:
///   draft  -> editable, not yet issued
///   open   -> sent/received, awaiting payment
///   partial-> some payment applied
///   paid   -> balance zero
///   void   -> cancelled; excluded from AR/AP totals
enum TransactionStatus {
  draft
  open
  partial
  paid
  void
}

model Invoice {
  id           String               @id @default(cuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  number       String
  customerId   String
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issueDate    DateTime
  dueDate      DateTime?
  memo         String               @default("")
  status       TransactionStatus    @default(draft)
  subtotal     Float                @default(0)
  taxTotal     Float                @default(0)
  total        Float                @default(0)
  amountPaid   Float                @default(0)
  balance      Float                @default(0)
  sentAt       DateTime?
  voidedAt     DateTime?
  lines        InvoiceLine[]
  applications PaymentApplication[]
  /// Owning organization (Batch 12).
  orgId        String

  @@unique([orgId, number])
  @@index([customerId])
  @@index([status])
  @@index([issueDate])
  @@index([orgId])
}

model InvoiceLine {
  id              String   @id @default(cuid())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position        Int
  productId       String?
  product         Product? @relation("InvoiceLineProduct", fields: [productId], references: [id], onDelete: SetNull)
  description     String   @default("")
  quantity        Float    @default(1)
  unitPrice       Float    @default(0)
  incomeAccountId String
  incomeAccount   Account  @relation("InvoiceLineIncomeAccount", fields: [incomeAccountId], references: [id], onDelete: Restrict)
  taxable         Boolean  @default(false)
  taxAmount       Float    @default(0)
  amount          Float    @default(0)
  /// Owning organization (Batch 12).
  orgId           String

  @@index([invoiceId, position])
  @@index([productId])
  @@index([incomeAccountId])
  @@index([orgId])
}

model Bill {
  id           String                   @id @default(cuid())
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
  number       String
  supplierId   String
  supplier     Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  billDate     DateTime
  dueDate      DateTime?
  memo         String                   @default("")
  status       TransactionStatus        @default(draft)
  subtotal     Float                    @default(0)
  taxTotal     Float                    @default(0)
  total        Float                    @default(0)
  amountPaid   Float                    @default(0)
  balance      Float                    @default(0)
  receivedAt   DateTime?
  voidedAt     DateTime?
  lines        BillLine[]
  applications BillPaymentApplication[]
  /// Owning organization (Batch 12).
  orgId        String

  @@unique([orgId, number])
  @@index([supplierId])
  @@index([status])
  @@index([billDate])
  @@index([orgId])
}

model BillLine {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  billId           String
  bill             Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  position         Int
  productId        String?
  product          Product? @relation("BillLineProduct", fields: [productId], references: [id], onDelete: SetNull)
  description      String   @default("")
  quantity         Float    @default(1)
  unitCost         Float    @default(0)
  expenseAccountId String
  expenseAccount   Account  @relation("BillLineExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  taxable          Boolean  @default(false)
  taxAmount        Float    @default(0)
  amount           Float    @default(0)
  /// Owning organization (Batch 12).
  orgId            String

  @@index([billId, position])
  @@index([productId])
  @@index([expenseAccountId])
  @@index([orgId])
}

/// Payment methods for customer payments and bill payments.
enum PaymentMethod {
  cash
  check
  card
  ach
  other
}

model Payment {
  id               String               @id @default(cuid())
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  number           String
  customerId       String
  customer         Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  paymentDate      DateTime
  method           PaymentMethod        @default(cash)
  reference        String               @default("")
  memo             String               @default("")
  amount           Float
  applied          Float                @default(0)
  unapplied        Float                @default(0)
  depositAccountId String
  depositAccount   Account              @relation("PaymentDepositAccount", fields: [depositAccountId], references: [id], onDelete: Restrict)
  depositedAt      DateTime?
  applications     PaymentApplication[]
  depositLines     DepositLine[]        @relation("DepositLinePayment")
  /// Owning organization (Batch 12).
  orgId            String

  @@unique([orgId, number])
  @@index([customerId])
  @@index([paymentDate])
  @@index([depositAccountId])
  @@index([orgId])
}

model PaymentApplication {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  paymentId String
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  amount    Float
  /// Owning organization (Batch 12).
  orgId     String

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@index([orgId])
}

model BillPayment {
  id              String                   @id @default(cuid())
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  number          String
  supplierId      String
  supplier        Supplier                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  paymentDate     DateTime
  method          PaymentMethod            @default(check)
  reference       String                   @default("")
  memo            String                   @default("")
  amount          Float
  applied         Float                    @default(0)
  unapplied       Float                    @default(0)
  sourceAccountId String
  sourceAccount   Account                  @relation("BillPaymentSourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  applications    BillPaymentApplication[]
  /// Owning organization (Batch 12).
  orgId           String

  @@unique([orgId, number])
  @@index([supplierId])
  @@index([paymentDate])
  @@index([sourceAccountId])
  @@index([orgId])
}

model BillPaymentApplication {
  id            String      @id @default(cuid())
  createdAt     DateTime    @default(now())
  billPaymentId String
  billPayment   BillPayment @relation(fields: [billPaymentId], references: [id], onDelete: Cascade)
  billId        String
  bill          Bill        @relation(fields: [billId], references: [id], onDelete: Restrict)
  amount        Float
  /// Owning organization (Batch 12).
  orgId         String

  @@unique([billPaymentId, billId])
  @@index([billPaymentId])
  @@index([billId])
  @@index([orgId])
}

/// Direct expenses (Phase 3 Task 10C).
/// Unlike bills, expenses are paid at the moment they're posted —
/// they don't create an AP liability. Used for card/cash purchases
/// where there's no supplier invoice cycle.
model Expense {
  id               String            @id @default(cuid())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  number           String
  expenseDate      DateTime
  method           PaymentMethod     @default(card)
  reference        String            @default("")
  memo             String            @default("")
  supplierId       String?
  supplier         Supplier?         @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  payeeName        String            @default("")
  paymentAccountId String
  paymentAccount   Account           @relation("ExpensePaymentAccount", fields: [paymentAccountId], references: [id], onDelete: Restrict)
  subtotal         Float             @default(0)
  taxTotal         Float             @default(0)
  total            Float             @default(0)
  status           TransactionStatus @default(draft)
  postedAt         DateTime?
  voidedAt         DateTime?
  lines            ExpenseLine[]
  /// Owning organization (Batch 12).
  orgId            String

  @@unique([orgId, number])
  @@index([expenseDate])
  @@index([supplierId])
  @@index([paymentAccountId])
  @@index([status])
  @@index([orgId])
}

model ExpenseLine {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  expenseId        String
  expense          Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  position         Int
  description      String   @default("")
  quantity         Float    @default(1)
  unitCost         Float    @default(0)
  expenseAccountId String
  expenseAccount   Account  @relation("ExpenseLineExpenseAccount", fields: [expenseAccountId], references: [id], onDelete: Restrict)
  taxable          Boolean  @default(false)
  taxAmount        Float    @default(0)
  amount           Float    @default(0)
  /// Owning organization (Batch 12).
  orgId            String

  @@index([expenseId, position])
  @@index([expenseAccountId])
  @@index([orgId])
}

// --- Staff Hub Phase 3 (operational engagement; not payroll math) ---

enum WorkAssignmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model WorkAssignment {
  id              String               @id @default(cuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  employeeId      String
  employee        Employee             @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  startTime       String?
  endTime         String?
  locationName    String
  locationAddress String?
  notes           String?
  status          WorkAssignmentStatus @default(SCHEDULED)
  createdByUserId String?
  createdBy       User?                @relation("WorkAssignmentCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
  orgId           String

  @@index([employeeId, date])
  @@index([date])
  @@index([orgId])
}

enum StaffAnnouncementCategory {
  GENERAL
  SAFETY
  HOLIDAY
  POLICY
  WEATHER
  PAYROLL
  SCHEDULE
}

enum StaffAnnouncementAudience {
  ALL
  EMPLOYEES
  MANAGERS
}

model StaffAnnouncement {
  id              String                    @id @default(cuid())
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  title           String
  body            String
  category        StaffAnnouncementCategory
  audience        StaffAnnouncementAudience
  startsAt        DateTime?
  endsAt          DateTime?
  active          Boolean                   @default(true)
  createdByUserId String?
  createdBy       User?                     @relation("StaffAnnouncementCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  /// Owning organization (Batch 12).
  orgId           String

  @@index([orgId])
}

enum NotificationChannel {
  IN_APP
  EMAIL_DRAFT
  WHATSAPP_DRAFT
  EMAIL_PROVIDER
  WHATSAPP_PROVIDER
}

enum NotificationStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
}

/// Foundation for future queued/sent messages — no auto-send in Phase 3.
model NotificationLog {
  id              String              @id @default(cuid())
  createdAt       DateTime            @default(now())
  sentAt          DateTime?
  channel         NotificationChannel
  recipientUserId String?
  recipientUser   User?               @relation("NotificationRecipientUser", fields: [recipientUserId], references: [id], onDelete: SetNull)
  employeeId      String?
  employee        Employee?           @relation("NotificationLogEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  subject         String
  status          NotificationStatus  @default(DRAFT)
  /// Owning organization (Batch 12).
  orgId           String

  @@index([createdAt])
  @@index([status])
  @@index([orgId])
}

model StaffQuizQuestion {
  id           String             @id @default(cuid())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  question     String
  choices      Json
  correctIndex Int
  explanation  String             @default("")
  active       Boolean            @default(true)
  attempts     StaffQuizAttempt[]
  /// Owning organization (Batch 12).
  orgId        String

  @@index([orgId])
}

model StaffQuizAttempt {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  questionId    String
  question      StaffQuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int
  correct       Boolean
  pointsAwarded Int               @default(0)
  /// Owning organization (Batch 12).
  orgId         String

  @@index([employeeId, createdAt])
  @@index([questionId])
  @@index([orgId])
}

model RewardLedger {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  points     Int
  reason     String
  /// Owning organization (Batch 12).
  orgId      String

  @@index([employeeId, createdAt])
  @@index([orgId])
}

/// Bank deposits (Phase 3 Task 10C).
/// Groups one or more undeposited customer payments into a single
/// bank transaction. When posted, each linked payment's
/// `depositedAt` is set so it can't be modified or re-deposited.
model Deposit {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  number        String
  depositDate   DateTime
  memo          String            @default("")
  bankAccountId String
  bankAccount   Account           @relation("DepositBankAccount", fields: [bankAccountId], references: [id], onDelete: Restrict)
  total         Float             @default(0)
  status        TransactionStatus @default(draft)
  postedAt      DateTime?
  voidedAt      DateTime?
  lines         DepositLine[]
  /// Owning organization (Batch 12).
  orgId         String

  @@unique([orgId, number])
  @@index([depositDate])
  @@index([bankAccountId])
  @@index([status])
  @@index([orgId])
}

model DepositLine {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  depositId   String
  deposit     Deposit  @relation(fields: [depositId], references: [id], onDelete: Cascade)
  position    Int
  paymentId   String?
  payment     Payment? @relation("DepositLinePayment", fields: [paymentId], references: [id], onDelete: Restrict)
  description String   @default("")
  amount      Float
  /// Owning organization (Batch 12).
  orgId       String

  @@index([depositId, position])
  @@index([paymentId])
  @@index([orgId])
}

// --- General ledger (Batch 8, R7) ---
// Double-entry journal core. Every posted business document writes exactly one
// balanced journal identified by a unique sourceKey (idempotent re-posts).
// Corrections never edit posted rows: a reversal journal (sourceType suffixed
// `_reversal`, reversalOfId pointing at the original) undoes the original.

enum JournalEntryStatus {
  posted
  void
}

model JournalEntry {
  id              String             @id @default(cuid())
  createdAt       DateTime           @default(now())
  date            DateTime
  memo            String             @default("")
  /// invoice | payment | bill | bill_payment | expense | payroll_run (+ `_reversal` variants)
  sourceType      String
  sourceId        String
  /// Unique idempotency key: `${sourceType}:${sourceId}`.
  sourceKey       String
  status          JournalEntryStatus @default(posted)
  reversalOfId    String?
  reversalOf      JournalEntry?      @relation("JournalReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversals       JournalEntry[]     @relation("JournalReversal")
  createdByUserId String?
  lines           JournalLine[]
  /// Owning organization (Batch 12).
  orgId           String

  @@unique([orgId, sourceKey])
  @@index([date])
  @@index([sourceType, sourceId])
  @@index([status])
  @@index([orgId])
}

model JournalLine {
  id        String       @id @default(cuid())
  createdAt DateTime     @default(now())
  entryId   String
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  position  Int
  accountId String
  account   Account      @relation(fields: [accountId], references: [id], onDelete: Restrict)
  /// Decimal money: exactly one of debit/credit is > 0 per line.
  debit     Decimal      @default(0) @db.Decimal(14, 2)
  credit    Decimal      @default(0) @db.Decimal(14, 2)
  memo      String       @default("")
  /// Owning organization (Batch 12).
  orgId     String

  @@index([entryId, position])
  @@index([accountId])
  @@index([orgId])
}

/// Versioned BVI statutory rate record. One row per effective tax year.
/// Payroll calculations keep reading OrgSettings; this table is the
/// audit/verification source of truth that those live values must match.
/// A version counts as verified only when sourceUrl is set and verifiedAt
/// is filled, and as approved for live use only when approvedAt is filled.
model StatutoryRateVersion {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Owning organization (Batch 12).
  orgId     String

  /// Tax year the rates apply to (e.g. 2026).
  effectiveYear Int
  /// Optional in-year effective range for mid-year rate changes.
  effectiveFrom DateTime?
  effectiveTo   DateTime?

  /// BVI Social Security Board contribution.
  ssbEmployeeRate  Float
  ssbEmployerRate  Float
  ssbAnnualCeiling Float
  ssbEnabled       Boolean @default(true)

  /// BVI National Health Insurance contribution.
  nhiEmployeeRate  Float
  nhiEmployerRate  Float
  nhiAnnualCeiling Float
  nhiEnabled       Boolean @default(true)

  /// BVI payroll tax (employee withholding + employer Class 1/2 share).
  payrollTaxEmployeeRate    Float
  payrollTaxEmployerClass   PayrollTaxClass @default(NOT_SET)
  payrollTaxAnnualExemption Float
  payrollTaxEnabled         Boolean         @default(true)

  /// Official source the values were checked against (laws.gov.vg, bvissb.vg, vinhi.vg, IRD).
  sourceUrl  String    @default("")
  /// When the values were last compared against the official source.
  verifiedAt DateTime?
  verifiedBy String    @default("")
  /// Owner / qualified BVI payroll-professional sign-off before live use.
  approvedAt DateTime?
  approvedBy String    @default("")

  @@unique([orgId, effectiveYear])
  @@index([effectiveYear])
  @@index([orgId])
}

/// Database-backed rate limiting for authentication endpoints
/// (sign-in attempts per IP+email, password-reset request intervals).
/// Replaces the previous in-memory maps so limits survive restarts and
/// work when more than one API process is running.
model AuthRateLimit {
  id      String   @id @default(cuid())
  /// Unique bucket key, e.g. "login:192.168.1.1:user@example.com" or "reset:user@example.com".
  key     String   @unique
  count   Int      @default(0)
  /// Attempts after this instant start a new window.
  resetAt DateTime

  @@index([resetAt])
}

/// Opening year-to-date payroll balances for employees whose pay history
/// predates this system (imported from a previous payroll provider).
/// `gross` feeds the payroll-tax annual-exemption calculation so mid-year
/// migrations tax the remainder of the year correctly; the other components
/// are kept for audit and future register/reconciliation reports.
model PayrollYtdOpeningBalance {
  id                 String   @id @default(cuid())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  employeeId         String
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Calendar year these opening balances apply to.
  year               Int
  gross              Float    @default(0)
  nhi                Float    @default(0)
  ssb                Float    @default(0)
  incomeTax          Float    @default(0)
  payrollTax         Float    @default(0)
  employerNhi        Float    @default(0)
  employerSsb        Float    @default(0)
  employerPayrollTax Float    @default(0)
  net                Float    @default(0)
  /// How the balance was recorded, e.g. "csv-import" or "manual".
  source             String   @default("csv-import")
  notes              String   @default("")
  importedBy         String   @default("")
  /// Owning organization (Batch 12).
  orgId              String

  @@unique([employeeId, year])
  @@index([year])
  @@index([orgId])
}

/// Leave policy: maps a staff-request type to a paid/unpaid leave scheme with
/// an optional annual allowance (0 = untracked). Approved requests consume
/// the allowance; unpaid-policy requests reduce fixed-basis pay pro-rata.
model LeavePolicy {
  id                  String           @id @default(cuid())
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  /// Stable machine code, e.g. ANNUAL, SICK, UNPAID.
  code                String
  name                String
  /// Staff-request type whose approved requests count against this policy.
  requestType         StaffRequestType
  paid                Boolean          @default(true)
  /// Business days per calendar year per employee; 0 means untracked/unlimited.
  annualAllowanceDays Float            @default(0)
  active              Boolean          @default(true)
  sortOrder           Int              @default(0)
  /// Owning organization (Batch 12).
  orgId               String

  @@unique([orgId, code])
  @@unique([orgId, requestType])
  @@index([orgId])
}
