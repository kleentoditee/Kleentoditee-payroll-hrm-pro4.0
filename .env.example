# Copy to .env in this folder (repo root). Used by API, Prisma (via packages/db scripts), and seed.

# Production/staging/CI default: PostgreSQL with Prisma migrations.
DATABASE_URL="postgresql://kleentoditee:kleentoditee@localhost:5432/kleentoditee?schema=public"

# Min ~32 chars in production. Dev default is fine for localhost only.
JWT_SECRET="dev-only-change-me-use-openssl-rand-hex-32-in-real-deploy"

# Required when NODE_ENV=production. Use comma-separated admin/tracker origins.
# CORS_ALLOWED_ORIGINS=https://admin.example.com,https://tracker.example.com

# Last resort on localhost only: passwordless "emergency" sign-in for the first user in the DB (see login page).
# Never enable in production. Remove before deploy.
# ALLOW_DEV_EMERGENCY_LOGIN=1

# Optional seed overrides (defaults shown in seed.ts)
# SEED_ADMIN_EMAIL=admin@kleentoditee.local
# SEED_ADMIN_PASSWORD=ChangeMe!Dev123
# SEED_ADMIN_NAME=Platform Admin

# Admin web → API (browser). For `next dev`, leave this UNSET so the admin uses a same-origin proxy
# to :8787 (avoids CORS / "Cannot talk to the API"). Set only for production or direct-URL debugging.
# NEXT_PUBLIC_API_URL=http://localhost:8787

# Public URL of the employee-tracker app (used by the API to build share links for admin). No trailing slash.
# Default in code is http://localhost:3001 if unset.
# EMPLOYEE_TRACKER_PUBLIC_URL=http://localhost:3001
# ADMIN_WEB_PUBLIC_URL=http://localhost:3000

# Server-side API proxy used by both Next.js web apps in production. On Render this is
# supplied automatically from the private API service as API_HOSTPORT.
# API_PROXY_TARGET=http://127.0.0.1:8787
# API_HOSTPORT=kleentoditee-api:10000

# Password reset links. APP_URL is a generic fallback; employee tracker URL is preferred for staff reset links.
# APP_URL=http://localhost:3001

# SMTP delivery for real password-reset emails.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="KleenToDiTee <no-reply@kleentoditee.local>"

# Optional: admin web only — fallback sign-in URL if the API does not expose /people/employees/:id/tracker-share yet.
# NEXT_PUBLIC_EMPLOYEE_TRACKER_URL=http://localhost:3001

# API: local folder for employee HR file uploads (profile + documents). Default: apps/api/uploads/hr when the API process cwd is apps/api. Ignored in git.
# UPLOADS_DIR=./uploads/hr

# Future HR document object storage. Leave unset/local for current local filesystem storage.
# OBJECT_STORAGE_PROVIDER=local
# OBJECT_STORAGE_PROVIDER=s3
# OBJECT_STORAGE_PROVIDER=r2
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=kleentoditee-hr-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=us-east-1
